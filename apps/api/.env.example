# These are read from the process environment (export them / set them in your host); no .env loader is built in.
# SQLite is used when this is not set. For production use PostgreSQL (install psycopg first).
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/mihrab

# REQUIRED in production: long random secret for signing tokens
JWT_SECRET=change-me-to-a-long-random-string

# The fixed system-manager account (created on first start if no admin exists)
ADMIN_LOGIN=admin@mihrab.local
ADMIN_PASSWORD=change-me

# Comma-separated list of origins allowed to call the API
# (the Capacitor Android app uses https://localhost)
CORS_ORIGINS=http://localhost:3010,https://localhost,capacitor://localhost

# Hours offset used to decide "today" (Damascus = 3)
TZ_OFFSET=3
